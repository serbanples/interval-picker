{
  "name": "interval-picker",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/interval-date-picker.js",
  "types": "./dist/interval-date-picker.d.ts",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:angular-element": "esbuild src/interval-date-picker.ts --bundle --format=iife --target=es2018 --outfile=examples/angular11/src/assets/interval-picker.js"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "prettier": "^3.6.2",
    "esbuild": "^0.24.2"
  }
}
