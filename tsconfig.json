{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "declaration": true,
    "outDir": "dist",
    "strict": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
