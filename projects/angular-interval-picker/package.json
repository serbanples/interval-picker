{
  "name": "@serbanples/angular-interval-picker",
  "version": "0.1.0",
  "description": "Native Angular 11 interval picker",
  "license": "MIT",
  "peerDependencies": {
    "@angular/common": "^11.0.0",
    "@angular/core": "^11.0.0",
    "rxjs": "^6.5.0",
    "@angular/material": "^11.0.0",
    "@angular/cdk": "^11.0.0",
    "@ngx-translate/core": "^13.0.0"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "format": "prettier --write src package.json ng-package.json tsconfig.lib.json",
    "format:check": "prettier --check src package.json ng-package.json tsconfig.lib.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@angular/common": "~11.2.14",
    "@angular/core": "~11.2.14",
    "@angular/compiler": "~11.2.14",
    "@angular/compiler-cli": "~11.2.14",
    "ng-packagr": "~11.2.4",
    "typescript": "~4.1.6",
    "prettier": "^3.6.2",
    "rxjs": "~6.6.7",
    "tslib": "^2.0.0",
    "@angular/animations": "~11.2.14",
    "@angular/material": "~11.2.13",
    "@angular/cdk": "~11.2.13",
    "@ngx-translate/core": "~13.0.0",
    "sass": "^1.32.0"
  }
}
